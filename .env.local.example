# Copie ce fichier en .env.local et remplis les valeurs

# URL Turso (récupère-la sur https://app.turso.tech → ton DB → Connect → libsql)
TURSO_DATABASE_URL=libsql://ton-db-nom.turso.io

# Token d'auth Turso (même page, onglet "Generate token")
TURSO_AUTH_TOKEN=ton-token-ici

# Secret pour les sessions (n'importe quelle chaîne longue)
SESSION_SECRET=change-me-to-a-random-secret-string
